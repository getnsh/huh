{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Huh",
  "version": "0.1.0",
  "identifier": "com.getnsh.huh",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "huh?",
        "width": 820,
        "height": 560,
        "minWidth": 700,
        "minHeight": 480,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0A0A0A",
        "visible": true
      },
      {
        "label": "hud",
        "url": "hud.html",
        "title": "huh? overlay",
        "width": 760,
        "height": 340,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "focusable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/128x128.png"],
    "publisher": "getnsh",
    "copyright": "Copyright (C) 2026 getnsh. GPL-3.0-or-later.",
    "shortDescription": "Hold. Speak. It's typed.",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
